FROM wechatopenai/weknora-ui:v0.8.2

# Same UI bundle as upstream; only the nginx config (template, proxy include, header maps) and the
# start wrapper differ.
COPY web/default.conf.template /etc/nginx/templates/default.conf.template
COPY web/00-railway-maps.conf /etc/nginx/conf.d/00-railway-maps.conf
COPY web/api-proxy.conf /etc/nginx/api-proxy.conf
COPY --chmod=755 web/entrypoint.sh /railway-entrypoint.sh

ENV PORT=80 \
    APP_HOST=app.railway.internal \
    APP_PORT=8080 \
    APP_SCHEME=http \
    DEFAULT_LOCALE=en-US

EXPOSE 80
ENTRYPOINT ["/railway-entrypoint.sh"]
